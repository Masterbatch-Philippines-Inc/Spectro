{% extends "base.django" %}
{% load static %}
{% block content %}
{% csrf_token %}
<section class="flex-1 min-h-0 flex flex-col overflow-hidden">
  <div class="shrink-0 flex items-center gap-2 sm:gap-2.5 flex-wrap px-3 sm:px-5 py-3 border-b border-border bg-card">
    {% include "components/shared/ui/dropdown.django" with dropdown_type="combobox" dropdown_id="productCodeFilter" dropdown_placeholder="Product Code" dropdown_remote_url=search_product_codes_url %}
    <div class="relative" data-dropdown-menu>
      <select id="standardFilter" class="hidden" disabled>
        <option value="">Standards</option>
      </select>
      <button id="standardFilterBtn" type="button" disabled
        class="disabled:opacity-50 disabled:cursor-not-allowed text-[12.5px] px-2.5 py-1.5 rounded-md border border-border bg-card min-w-[170px] flex items-center justify-between gap-1.5 cursor-pointer hover:bg-accent">
        <span id="standardFilterLabel" class="truncate">Standards</span>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div id="standardFilterPanel" class="hidden absolute left-0 top-[calc(100%+4px)] z-50 w-[220px] max-h-[260px] overflow-y-auto bg-card border border-border rounded-md shadow-lg p-1.5 flex flex-col gap-0.5"></div>
    </div>
    {% include "components/shared/ui/dropdown.django" with dropdown_type="menu" dropdown_id="columnVisibilityDropdown" dropdown_label="Columns" dropdown_disabled=True %}
    {% include "components/shared/ui/input.django"    with input_id="searchInput" input_type="text" input_placeholder="Search anything in the table..." input_class="flex-1 min-w-[140px] sm:min-w-[180px] max-w-[340px]" input_disabled=True %}
    {% include "components/shared/ui/button.django"   with btn_id="rereadSelectedBtn" btn_label="Re-Read Selected Samples" btn_variant="secondary" btn_extra_class="w-full sm:w-auto sm:ml-auto border border-border hover:bg-accent transition" btn_disabled=True %}
    {% include "components/shared/ui/button.django"   with btn_id="generateReportBtn" btn_label="Generate Report for this Product Code" btn_variant="primary" btn_extra_class="w-full sm:w-auto btn bg-[hsl(var(--primary))] text-[hsl(var(--primary-foreground))] border border-[hsl(var(--primary))] hover:opacity-90 transition" btn_disabled=True %}
  </div>
  {% include "components/shared/ui/table.django" with table_id="dataTable" header_row_id="headerRow" table_body_id="tableBody" empty_title="No Data Available" empty_subtitle="Try selecting one product code and one standard sample" %}
</section>
{% endblock %}

{% block extra_js %}
<script>
  window.SAMPLES_RECORD_URLS = {
    exportReport: "{% url 'api_export_samples_report' %}",
    standardsForProductCode: "{% url 'api_standards_for_product_code' %}",
    lotSamplesForStandard: "{% url 'api_lot_samples_for_standard' %}",
    saveVisualJudgement: "{% url 'api_save_visual_judgement' %}",
    saveVisualFailReason: "{% url 'api_save_visual_fail_reason' %}",
    saveSpectroRemarks: "{% url 'api_save_spectro_remarks' %}",
    saveSpecialPassBy: "{% url 'api_save_special_pass_by' %}",
    samplesReader: "{% url 'samples_reader' %}"
  };
</script>
{% endblock %}