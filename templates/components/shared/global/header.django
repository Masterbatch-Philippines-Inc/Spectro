{% if user.is_authenticated %}
<header class="h-[52px] shrink-0 flex items-center gap-2 sm:gap-3.5 px-3 sm:px-5 border-b border-border bg-card">
  <button id="hamburgerBtn" class="hamburger-btn w-[30px] h-[30px] rounded-md border border-border bg-card flex items-center justify-center hover:bg-accent shrink-0">
    <span class="hamburger-bars">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </button>
  <div class="w-px h-5 bg-border hidden sm:block"></div>
  <div class="text-[13px] sm:text-[15px] font-bold tracking-wide truncate">
    {% if request.resolver_match.url_name == 'samples_record' %}
      Samples Record
    {% elif request.resolver_match.url_name == 'samples_reader' %}
      Value Reader
    {% endif %}
  </div>
  <button id="headerThemeToggle" type="button" aria-label="Toggle theme" class="theme-toggle-btn ml-auto w-8 h-8 rounded-md border border-border bg-card flex items-center justify-center hover:bg-accent shrink-0 relative overflow-hidden">
    <svg class="theme-icon theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
    <svg class="theme-icon theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
  </button>
</header>
{% endif %}