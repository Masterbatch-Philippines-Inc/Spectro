{% comment %}
============================================================
Generic modal system. Any modal is a div[data-modal="<id>"], opened by
any element with data-modal-target="<id>", closed by any element
inside it with data-modal-close (or clicking the overlay backdrop).
modal.js handles all of this generically -- no modal-specific JS here.

Concrete modals included below (Scatter maximize). Add more by
copying the pattern -- no changes to modal.js needed.

Note: the "Recalculate Spectro Judgement?" STD ΔE confirm modal that
used to live here was removed along with Standard ΔE editing from the
Samples Record page -- that responsibility now lives entirely in the
Samples Reader (Step 3), which has its own inline validation instead
of a confirm popup.
============================================================
{% endcomment %}

<div data-modal="scatterModal" class="fixed inset-0 bg-black/40 backdrop-blur-[2px] hidden items-center justify-center z-[100] p-5">
  <div class="modal-anim bg-card border border-border rounded-xl shadow-lg p-6 w-full max-w-[520px]">
    <div class="flex items-center justify-between mb-3">
      <span class="text-[13px] font-bold uppercase tracking-wide text-muted-foreground">Δa* and Δb* Graph</span>
      <button data-modal-close type="button" class="w-7 h-7 rounded-md flex items-center justify-center text-muted-foreground hover:bg-accent hover:text-foreground" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <svg class="w-full h-auto block" id="scatterSvgModal" viewBox="0 0 200 180">
      <g id="scatterAxisModal"></g>
      <g id="scatterPointsModal"></g>
    </svg>
    <div class="flex items-center gap-3 mt-2 text-[13px] text-muted-foreground">
      <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full inline-block bg-muted-foreground/50"></span>Passed</span>
      <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-danger inline-block"></span>Failed</span>
    </div>
  </div>
</div>

<div id="scatterTooltipModal" class="hidden fixed z-[300] pointer-events-none bg-foreground text-background text-[13px] font-medium rounded-md px-3.5 py-2.5 shadow-lg leading-relaxed"></div>